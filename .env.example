# Copy this file to `.env` in the repo root and fill in your own keys.
#   cp .env.example .env
# `.env` is gitignored — never commit real keys.

# Google Gemini API key, used by all `google.genai` calls
# (query.py, wiki_corpus/llm_judgements.py, convoKit/*.py, and the notebooks).
# Get one at https://aistudio.google.com/apikey
google_api_key=

# Hugging Face token. Optional — models download anonymously, but a token
# raises rate limits and is required for any gated model.
# Get one at https://huggingface.co/settings/tokens
hf_token=
